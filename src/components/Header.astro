---
import Distronaut from "../assets/distronaut.webp";

const pathname = Astro.url.pathname;

const NAV_LINKS = [
  { label: "Distros", href: "/distros" },
  { label: "Rankings", href: "/rankings" },
  { label: "Battles", href: "/battles" },
  { label: "Tier List", href: "/tier-list" },
  { label: "News", href: "/news" },
];

const isActivePath = (href: string) => {
  if (href === "/") {
    return pathname === "/";
  }

  return pathname.startsWith(href);
};
---

<header class="fixed top-0 inset-x-0 z-50">
  <div class="max-w-5xl mx-auto px-4 py-4">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-8">
        <a
          href="/"
          class="flex items-center gap-2 transition-opacity hover:opacity-80"
        >
          <img
            src={Distronaut.src}
            alt="Distronaut"
            class="w-11 h-11 select-none"
          />

          <span class="text-xl font-black tracking-tight"> Distronaut </span>
        </a>

        <nav>
          <ul class="flex items-center gap-6">
            {
              NAV_LINKS.map((link) => {
                const isActive = isActivePath(link.href);

                return (
                  <li>
                    <a
                      href={link.href}
                      aria-current={isActive ? "page" : undefined}
                      class:list={[
                        "text-sm transition-colors duration-200",
                        "hover:text-purple-300",
                        isActive ? "font-semibold text-white" : "text-zinc-400",
                      ]}
                    >
                      {link.label}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
      </div>
    </div>
  </div>
</header>
